# 🐍 ENTORNOS VIRTUALES Y CACHE DE PYTHON
# ═══════════════════════════════════════════════════════════════
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
eggs/
sdist/
wheels/
develop-eggs/
.installed.cfg
MANIFEST

